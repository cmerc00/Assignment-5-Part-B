    cout << "Software Engineers"<<endl;
    soft.setName("Suzan");
    soft.setSalary(108080);
    printName(soft);
    printSalary(soft);
    
    Sales sale;
    cout << "Sales Person"<<endl;
    sale.setName("Samuel");
    sale.setSalary(64310);
    printName(sale);
    printSalary(sale);
    

    
    
    return 0;
}
void printName(Worker &printName)
{
    cout << printName.getName()<<endl;
}
void printSalary(Worker &printSal)
{
    cout << setprecision(2)<< fixed;
    cout << "Salary: $"<<printSal.getSalary()<<endl;

    cout << "Salary per week: $"<< printSal.salaryPerWeek()<<"\n\n";
}

using namespace std;

void printSalary(Worker &);
void printName(Worker &);

int main() {
   
    Doctor doc;
    cout<< "Doctor"<<endl;
    doc.setName("Dazy");
    doc.setSalary(294000);
    printName(doc);
    printSalary(doc);
    
    Lawyer law;
    cout << "Lawyer"<<endl;
    law.setName("Lary");
